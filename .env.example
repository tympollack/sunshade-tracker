# ---------------------------------------------------------------
# SunShade Tracker — Environment Variables
# Copy this file to .env.local (gitignored) and fill in values.
# NEXT_PUBLIC_ vars are safe to expose to the browser.
# All others are server-only — NEVER prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------

# ----------------------------------------------------------
# Supabase — shared SunShade ecosystem project
# The tracker schema is: "tracker"
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role — SERVER ONLY. Rotate immediately if committed.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ----------------------------------------------------------
# SunShade Hub SSO
# Hub is the central Supabase Auth SSO across all *.sunshade.icu apps.
# The tracker redirects unauthenticated users to Hub for sign-in,
# which then issues a ?code= param back to /auth/callback.
# ----------------------------------------------------------
# Hub base URL (no trailing slash)
NEXT_PUBLIC_HUB_URL=https://hub.sunshade.icu

# Staging Hub (auto-detected in non-production environments)
# NEXT_PUBLIC_HUB_STAGING_URL=https://hub-stag.sunshade.icu

# ----------------------------------------------------------
# App Config
# ----------------------------------------------------------
# Full public URL of this tracker instance (no trailing slash)
# Used to construct absolute callback URLs for Hub SSO redirects.
NEXT_PUBLIC_APP_URL=https://track.sunshade.icu

# Deployment environment tag (production | staging | development)
NEXT_PUBLIC_ENVIRONMENT=development

# ----------------------------------------------------------
# Dev / Local Auth Bypass
# Set to "true" to enable instant dev login without Hub SSO.
# NEVER set to true in production.
# ----------------------------------------------------------
NEXT_PUBLIC_BYPASS_AUTH=true

# ----------------------------------------------------------
# Optional: Direct PostgreSQL (for migrations / admin scripts)
# ----------------------------------------------------------
# DATABASE_URL=postgresql://postgres:[password]@db.<project-ref>.supabase.co:5432/postgres
