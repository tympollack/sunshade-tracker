# ---------------------------------------------------------------
# SunShade Tracker — Environment Variables
# Copy this file to .env.local (gitignored) and fill in values.
# NEXT_PUBLIC_ vars are safe to expose to the browser.
# All others are server-only — NEVER prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------

# ----------------------------------------------------------
# Supabase — shared SunShade ecosystem project
# Tracker application data uses the "tracker" schema.
# Placeholder values support zero-secret local builds and
# public-page smoke tests only. Replace them for real data.
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Service role — SERVER ONLY. Rotate immediately if committed.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ----------------------------------------------------------
# SunShade Hub SSO
# Hub is the central Supabase Auth SSO across *.sunshade.icu apps.
# Production Hub: https://hub.sunshade.icu
# Staging Hub is auto-derived as https://hub-stag.sunshade.icu.
# ----------------------------------------------------------
# Optional override. Leave unset for automatic environment-derived Hub routing.
# NEXT_PUBLIC_HUB_URL=https://hub-stag.sunshade.icu

# ----------------------------------------------------------
# App Config
# Full public URL of this Tracker instance (no trailing slash).
# Used to construct absolute callback URLs for Hub SSO redirects.
# Production: https://track.sunshade.icu
# Staging: https://track-stag.sunshade.icu
# ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# ----------------------------------------------------------
# Dev / Local Auth Bypass
# Set to "true" for local development without Hub SSO.
# NEVER set to true in production.
# ----------------------------------------------------------
NEXT_PUBLIC_BYPASS_AUTH=true

# ----------------------------------------------------------
# Optional integration secrets
# Uncomment and fill only when the related integration is used.
# ----------------------------------------------------------
# CRON_SECRET=<cron-bearer-secret>
# RESEND_API_KEY=<resend-api-key>
# RESEND_FROM_EMAIL=SunShade Tracker <notifications@sunshade.icu>
# TRACKER_WEBHOOK_SECRET=<outbound-automation-webhook-secret>
# GITHUB_WEBHOOK_SECRET=<github-bounty-webhook-secret>
# BOUNTY_WEBHOOK_SECRET=<bounty-webhook-secret>
# DEPLOYMENT_WEBHOOK_SECRET=<deployment-webhook-secret>
# OBSERVABILITY_WEBHOOK_SECRET=<observability-webhook-secret>
# CI_RUNNER_WEBHOOK_SECRET=<ci-runner-webhook-secret>
# WEBHOOK_SIGNING_SECRET=<ci-runner-webhook-secret-alias>
# SUNSHADE_ECOSYSTEM_WEBHOOK_SECRET=<shared-ecosystem-webhook-secret>
# SUNSHADE_WEBHOOK_SECRET=<shared-webhook-fallback-secret>
# Local-only outbound webhook escape hatch. NEVER enable in production.
# ALLOW_LOCAL_WEBHOOKS=false

# ----------------------------------------------------------
# Optional CI failure bridge
# Used when CI reports failed typecheck or test runs to Tracker.
# ----------------------------------------------------------
# SUNSHADE_TRACKER_TOKEN=<workspace-api-key>
# SUNSHADE_TRACKER_URL=https://track-stag.sunshade.icu

# ----------------------------------------------------------
# Optional CLI / MCP client configuration
# These configure local clients. They do not configure the server.
# Use https://track-stag.sunshade.icu for staging clients.
# ----------------------------------------------------------
# SUNSHADE_API_KEY=<workspace-api-key>
# TRACKER_API_KEY=<workspace-api-key>
# SUNSHADE_BASE_URL=https://track-stag.sunshade.icu
# TRACKER_BASE_URL=https://track-stag.sunshade.icu
# SUNSHADE_TENANT=<workspace-slug>
# TRACKER_TENANT=<workspace-slug>
# SUNSHADE_PROJECT=<project-slug>
# TRACKER_PROJECT=<project-slug>
# SUNSHADE_RUNNER_ID=<runner-name>
# AGENT_NAME=<runner-name>
