{
  "name": "sunshade-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone, multi-tenant Project Tracker utility service with dynamic schemaless validation and Gemini Spark ingestion",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "lint:filesize": "node scripts/lint-filesize.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "generate:assets": "node scripts/generate-assets.mjs",
    "verify:mcp": "node --experimental-strip-types scripts/verify-supabase-mcp.ts",
    "verify:mcp:synthetic": "node --experimental-strip-types scripts/verify-supabase-mcp.ts --synthetic",
    "audit:db": "node --experimental-strip-types scripts/audit-db-pre-renewal.ts",
    "verify:context": "node --experimental-strip-types scripts/verify-context-trim.ts"
  },
  "dependencies": {
    "@digitalcanopy/supabase": "^0.1.0",
    "@digitalcanopy/ui": "^0.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "json5": "^2.2.3",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native-web": "^0.21.3",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/json5": "^0.0.30",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
